service CharacterService {
  rpc UpgradeTalent (UpgradeTalentRequest) returns (UpgradeTalentResponse);
  rpc GetTalents (GetTalentsRequest) returns (GetTalentsResponse);
}

message GetTalentsRequest {
  int32 character_id = 1;
}

message GetTalentsResponse {
  bool success = 1;
  int32 talent_points = 2;
  map<string, int32> talents = 3;
}

message UpgradeTalentRequest {
  int32 character_id = 1;
  string talent_id = 2;
}

message UpgradeTalentResponse {
  bool success = 1;
  string message = 2;
  int32 new_level = 3;
}
