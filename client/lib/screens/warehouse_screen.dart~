import 'package:flutter/material.dart';
import '../gen/city.pbgrpc.dart';
import '../services/city_client.dart';
import '../services/session.dart';
import '../services/localization.dart';

class WarehouseScreen extends StatefulWidget {
  const WarehouseScreen({super.key});

  @override
  State<WarehouseScreen> createState() => _WarehouseScreenState();
}

class _WarehouseScreenState extends State<WarehouseScreen> {
  final _client = CityClient();
  List<ResourceEntry> _resources = [];
  bool _loading = true;

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final charId = Session.characterId;
    if (charId == null) return;

    setState(() => _loading = true);
    try {
      await _client.connect();
      final resp = await _client.getCity(charId);
      
      if (resp.success) {
        // Сортируем ресурсы по алфавиту для удобства
        final sortedResources = List<ResourceEntry>.from(resp.resources);
        sortedResources.sort((a, b) => a.resourceType.compareTo(b.resourceType));
        
        setState(() {
          _resources = sortedResources;
          _loading = false;
        });
      } else {
        setState(() => _loading = false);
      }
    } catch (e) {
      debugPrint('Warehouse load error: $e');
      setState(() => _loading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Склад')),
      body: _loading
          ? const Center(child: CircularProgressIndicator())
          : _resources.isEmpty
              ? const Center(child: Text('Склад пуст'))
              : ListView.builder(
                  padding: const EdgeInsets.all(16),
                  itemCount: _resources.length,
                  itemBuilder: (context, index) {
                    final res = _resources[index];
                    return Card(
                      margin: const EdgeInsets.only(bottom: 8),
                      child: ListTile(
                        title: Text(resourceName(res.resourceType)),
                        trailing: Text(
                          '${res.amount}',
                          style: const TextStyle(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ),
                    );
                  },
                ),
    );
  }
}
