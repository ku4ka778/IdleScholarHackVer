import 'package:flutter/material.dart';
import '../services/city_client.dart';
import '../services/session.dart';

class CityHallScreen extends StatefulWidget {
  const CityHallScreen({super.key});

  @override
  State<CityHallScreen> createState() => _CityHallScreenState();
}

class _CityHallScreenState extends State<CityHallScreen> {
  final _client = CityClient();
  int _cityLevel = 1;
  Map<String, int> _upgrades = {};
  Map<String, int> _resources = {};
  bool _loading = true;

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final charId = Session.characterId;
    if (charId == null) return;

    setState(() => _loading = true);
    try {
      await _client.connect();
      final resp = await _client.getCity(charId);
      if (resp.success) {
        setState(() {
          _cityLevel = resp.level;
          _upgrades = resp.upgrades.map((key, value) => MapEntry(key, value.toInt()));
          _resources = { for (var r in resp.resources) r.resourceType : r.amount.toInt() };
          _loading = false;
        });
      }
    } catch (e) {
      debugPrint('Error: $e');
      setState(() => _loading = false);
    }
  }

  Future<void> _upgrade(String code) async {
    final charId = Session.characterId;
    if (charId == null) return;

    try {
      final resp = await _client.upgradeBuilding(charId, code);
      if (resp.success) {
        _load();
      } else {
        if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(resp.message)));
      }
    } catch (e) {
      debugPrint('Upgrade error: $e');
    }
  }

  Widget _buildUpgradeCard(String code, String name, String desc) {
    final level = _upgrades[code] ?? 0;
    final nextLevel = level + 1;
    
    final woodCost = nextLevel * 50;
    final stoneCost = nextLevel * 30;

    final haveTwig = _resources['twig'] ?? 0;
    final haveStone = _resources['stone'] ?? 0;

    final canAfford = haveTwig >= woodCost && haveStone >= stoneCost;

    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text('$name [Уровень: $level]', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
            Text(desc, style: const TextStyle(fontSize: 12, color: Colors.grey)),
            const SizedBox(height: 8),
            Text('Стоимость: $woodCost веточек, $stoneCost камней', 
              style: TextStyle(color: canAfford ? Colors.green : Colors.red)),
            const SizedBox(height: 8),
            ElevatedButton(
              onPressed: canAfford ? () => _upgrade(code) : null,
              child: const Text('УЛУЧШИТЬ'),
            ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    if (_loading) return const Scaffold(body: Center(child: CircularProgressIndicator()));

    return Scaffold(
      appBar: AppBar(title: Text('Главное здание (Уровень $_cityLevel)')),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          _buildUpgradeCard('gold_mine', 'Золотая шахта', 'Увеличивает добычу золота в экспедициях.'),
          _buildUpgradeCard('library', 'Библиотека', 'Увеличивает получаемый опыт.'),
          _buildUpgradeCard('warehouse', 'Улучшенный склад', 'Позволяет хранить больше ресурсов.'),
        ],
      ),
    );
  }
}
