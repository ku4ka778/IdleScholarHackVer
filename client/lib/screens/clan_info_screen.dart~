import 'package:flutter/material.dart';
import '../services/api_client.dart';
import '../services/session.dart';

class ClanInfoScreen extends StatefulWidget {
  final int clanId;
  const ClanInfoScreen({super.key, required this.clanId});

  @override
  State<ClanInfoScreen> createState() => _ClanInfoScreenState();
}

class _ClanInfoScreenState extends State<ClanInfoScreen> {
  Map<String, dynamic>? _clanInfo;
  List<Map<String, dynamic>> _members = [];
  bool _loading = true;
  int _myGold = 0;

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final charId = Session.characterId;
    if (charId == null) return;

    setState(() => _loading = true);
    try {
      final resp = await apiClient.getClanInfo(widget.clanId);
      final charResp = await apiClient.getCharacter(charId);

      if (resp['success'] == true) {
        setState(() {
          _clanInfo = resp;
          _members = (resp['members'] as List<dynamic>?)?.cast<Map<String, dynamic>>() ?? [];
          _myGold = (charResp['gold'] as num?)?.toInt() ?? 0;
          _loading = false;
        });
      }
    } catch (e) {
      debugPrint('Clan load error: $e');
      setState(() => _loading = false);
    }
  }

  Future<void> _deposit(int amount) async {
    final charId = Session.characterId;
    if (charId == null) return;

    if (_myGold < amount) {
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Недостаточно золота!')));
      return;
    }

    try {
      final resp = await apiClient.depositClanGold(charId, amount);
      if (resp['success'] == true) {
        ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Золото внесено в банк клана!')));
        _load(); 
      } else {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(resp['message'] ?? 'Error')));
      }
    } catch (e) {
      debugPrint('Deposit error: $e');
    }
  }

  Future<void> _buyBuff(String code) async {
    final charId = Session.characterId;
    if (charId == null) return;

    try {
      final resp = await apiClient.buyClanBuff(charId, code);
      if (resp['success'] == true) {
        ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Бафф клана активирован!')));
        _load();
      } else {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(resp['message'] ?? 'Error')));
      }
    } catch (e) {
      debugPrint('Buy buff error: $e');
    }
  }

  @override
  Widget build(BuildContext context) {
    if (_loading) return const Scaffold(body: Center(child: CircularProgressIndicator()));
    if (_clanInfo == null) return const Scaffold(body: Center(child: Text('Клан не найден')));

    final bankGold = (_clanInfo!['bank_gold'] as num?)?.toInt() ?? 0;
    final activeBuff = _clanInfo!['active_buff'] as String? ?? '';
    final buffExpires = (_clanInfo!['buff_expires_at'] as num?)?.toInt() ?? 0;
    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
    final isBuffActive = buffExpires > now;

    return Scaffold(
      appBar: AppBar(title: Text('Клан: ${_clanInfo!['name']}')),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Card(
              child: Padding(
                padding: const EdgeInsets.all(16.0),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text('Клановый Банк', style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),
                    const SizedBox(height: 8),
                    Text('Баланс: $bankGold золота', style: const TextStyle(fontSize: 18, color: Colors.amber)),
                    const SizedBox(height: 16),
                    const Text('Ваше золото: $_myGold', style: TextStyle(color: Colors.grey)),
                    const SizedBox(height: 8),
                    Row(
                      children: [
                        ElevatedButton(
                          onPressed: () => _deposit(100),
                          child: const Text('Внести 100'),
                        ),
                        const SizedBox(width: 8),
                        ElevatedButton(
                          onPressed: () => _deposit(1000),
                          child: const Text('Внести 1000'),
                        ),
                      ],
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 16),

            Card(
              child: Padding(
                padding: const EdgeInsets.all(16.0),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text('Баффы Клана', style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),
                    const SizedBox(height: 8),
                    if (isBuffActive) ...[
                      Text('Активен бафф: $activeBuff', style: const TextStyle(color: Colors.green, fontWeight: FontWeight.bold)),
                      Text('Осталось: ${(buffExpires - now) ~/ 3600} ч.', style: const TextStyle(color: Colors.grey)),
                      const SizedBox(height: 16),
                    ],
                    ListTile(
                      title: const Text('+20% к Опыту (24ч)'),
                      subtitle: const Text('Стоимость: 10,000 золота клана'),
                      trailing: ElevatedButton(
                        onPressed: bankGold >= 10000 && !isBuffActive ? () => _buyBuff('exp_boost') : null,
                        child: const Text('КУПИТЬ'),
                      ),
                    ),
                    ListTile(
                      title: const Text('+20% к Золоту (24ч)'),
                      subtitle: const Text('Стоимость: 15,000 золота клана'),
                      trailing: ElevatedButton(
                        onPressed: bankGold >= 15000 && !isBuffActive ? () => _buyBuff('gold_boost') : null,
                        child: const Text('КУПИТЬ'),
                      ),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 24),

            const Text('Участники клана:', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
            const SizedBox(height: 8),
            ..._members.map((m) => ListTile(
              leading: const CircleAvatar(child: Icon(Icons.person)),
              title: Text(m['name']),
              subtitle: Text('Уровень: ${m['level']}'),
              trailing: m['name'] == _clanInfo!['leader_name'] 
                  ? const Icon(Icons.star, color: Colors.amber) 
                  : null,
            )),
          ],
        ),
      ),
    );
  }
}
