import 'package:flutter/material.dart';
import 'main_menu_screen.dart'; 

class AuthScreen extends StatefulWidget {
  const AuthScreen({super.key});

  @override
  State<AuthScreen> createState() => _AuthScreenState();
}

class _AuthScreenState extends State<AuthScreen> {
  bool isLogin = true;
  bool _obscurePassword = true;
  bool _obscureConfirm  = true;

  final loginController = TextEditingController();
  final passwordController = TextEditingController();
  final emailController = TextEditingController();
  final confirmController = TextEditingController();

  @override
  void dispose() {
    loginController.dispose();
    passwordController.dispose();
    emailController.dispose();
    confirmController.dispose();
    super.dispose();
  }

  // ПРОВЕРЯЕМ ПАРОЛЬ ПРИ РЕГИСТРЕЙШЕН
  String? validatePassword(String pass) {
    if (pass.length < 8) {
      return 'Пароль должен быть минимум 8 символов';
    }
    if (!RegExp(r'[0-9]').hasMatch(pass)) {
      return 'Пароль должен содержать хотя бы одну цифру';
    }
    return null;
  }

String? validatePasswordError(String pass) {
  if (pass.length < 8 || !RegExp(r'[0-9]').hasMatch(pass)) {
    return 'Пароль не верный';
  }
  return null;
}

  String? validateEmail(String email) {
  if (email.isEmpty) {
    return 'Введите email';
  }
  // ПРОВЕРЯЕМ ЭМЭЙЛ
  final emailRegex = RegExp(r'^[\w\.\-]+@[\w\-]+\.[a-zA-Z]{2,}$');
  if (!emailRegex.hasMatch(email)) {
    return 'Некорректный email';
  }
  return null;
}

  void submit() {
    final login = loginController.text.trim();
    final pass = passwordController.text.trim();

    if (login.isEmpty) {
      _snack('Введите логин');
      return;
    }

    if (isLogin) {
  // проверка
  if (pass.isEmpty) {
    _snack('Введите пароль');
    return;
  }
  if (pass.length < 8 || !RegExp(r'[0-9]').hasMatch(pass)) {
    _snack('Пароль не верный');
    return;
  }
} else {
  // проверка 
  final passError = validatePassword(pass);
  if (passError != null) {
    _snack(passError);
    return;
  }
}

    if (!isLogin) {
  final email = emailController.text.trim();
  final emailError = validateEmail(email);
  if (emailError != null) {
    _snack(emailError);
    return;
  }

  final confirm = confirmController.text.trim();
  if (pass != confirm) {
    _snack('Пароли не совпадают');
    return;
  }
}
    // ПЕРЕХОД В МЕЙН
    Navigator.pushReplacement(
  context,
  MaterialPageRoute(
    builder: (context) => GameMenuScreen(login: login), 
  ),
);
  }

  void _snack(String text) {
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(text)));
  }

  @override
  Widget build(BuildContext context) {
    final screenWidth = MediaQuery.of(context).size.width;
    final screenHeight = MediaQuery.of(context).size.height;

    final fontTitle  = (screenWidth * 0.03).clamp(20.0, 36.0);
    final fontLabel  = (screenWidth * 0.018).clamp(12.0, 18.0);
    final fontInput  = (screenWidth * 0.05).clamp(14.0, 22.0);
    final fontButton = (screenWidth * 0.022).clamp(15.0, 24.0);

    final formWidth = (screenWidth * 0.55).clamp(300.0, 550.0);
    final fieldHeight = (screenHeight * 0.07).clamp(45.0, 65.0);
    final gap = (screenHeight * 0.02).clamp(10.0, 20.0);

    return Scaffold(
      body: Stack(
        children: [
          // ФОН
          Positioned.fill(
            child: Container(
              color: const Color(0xFFEADDCD),
              child: CustomPaint(painter: PaperTexturePainter()),
            ),
          ),

          // СЛЕВА СКЕТЧ ХЗ НУЖЕН ИЛИ НЕТ ЕСЛИ ЧЕ ЗАМЕНИМ
          Positioned(
            left: 0, top: 0, bottom: 0,
            width: screenWidth * 0.55,
            child: Opacity(
              opacity: 0.35,
              child: Image.asset(
                'assets/images/sketch1.png',
                fit: BoxFit.fitHeight,
                alignment: Alignment.centerLeft,
              ),
            ),
          ),


          // РЕГИСТРЕЙШЕН
          Center(
            child: SingleChildScrollView(
              child: SizedBox(
                width: formWidth,
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Text(
                      isLogin ? "ВХОД" : "РЕГИСТРАЦИЯ",
                      style: TextStyle(
                        fontSize: fontTitle * 2,
                        fontWeight: FontWeight.bold,
                        letterSpacing: 3,
                        color: Colors.black87,
                      ),
                    ),
                    SizedBox(height: gap * 1.5),

                    _buildField(
                      label: "ЛОГИН",
                      controller: loginController,
                      icon: Icons.person_outline,
                      height: fieldHeight,
                      fontLabel: fontLabel * 1.3,
                      fontInput: fontInput,
                    ),
                    SizedBox(height: gap),

                    if (!isLogin) ...[
                      _buildField(
                        label: "EMAIL",
                        controller: emailController,
                        icon: Icons.email_outlined,
                        height: fieldHeight,
                        fontLabel: fontLabel * 1.3,
                        fontInput: fontInput,
                      ),
                      SizedBox(height: gap),
                    ],

                    _buildField(
  label: "ПАРОЛЬ (сука нормальный пароль напиши по хорошему)",
  controller: passwordController,
  icon: Icons.lock_outline,
  obscure: _obscurePassword,                          
  showToggle: true,                                   
  onToggle: () => setState(() => _obscurePassword = !_obscurePassword), // ПЕРЕКЛЮЧИТЬ ПАРОЛЬ ПОСМОТРЕТЬ НЕ ПОСМОТРЕТЬ
  height: fieldHeight,
  fontLabel: fontLabel * 1.3 ,
  fontInput: fontInput,
),
SizedBox(height: gap),

                    if (!isLogin) ...[
  _buildField(
    label: "ПОВТОРИТЕ ПАРОЛЬ (смотри сука не ошибись)",
    controller: confirmController,
    icon: Icons.lock_outline,
    obscure: _obscureConfirm,                          // ПЕРЕКЛЮЧИТЬ ПАРОЛЬ ПОСМОТРЕТЬ НЕ ПОСМОТРЕТЬ
    showToggle: true,
    onToggle: () => setState(() => _obscureConfirm = !_obscureConfirm),
    height: fieldHeight,
    fontLabel: fontLabel * 1.3,
    fontInput: fontInput,
  ),
  SizedBox(height: gap),
],

                    _buildButton(
                      text: isLogin ? "ВОЙТИ" : "СОЗДАТЬ АККАУНТ",
                      fontSize: fontButton,
                      height: fieldHeight * 1.1,
                      onTap: submit,
                    ),
                    SizedBox(height: gap),

                    GestureDetector(
                      onTap: () => setState(() => isLogin = !isLogin),
                      child: Text(
                        isLogin
                            ? "Нет аккаунта? Зарегистрироваться"
                            : "Уже есть аккаунт? Войти",
                        style: TextStyle(
                          fontSize: fontLabel * 1.3,
                          color: Colors.black54,
                          decoration: TextDecoration.underline,
                          decorationStyle: TextDecorationStyle.wavy,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildField({
  required String label,
  required TextEditingController controller,
  required IconData icon,
  required double height,
  required double fontLabel,
  required double fontInput,
  bool obscure = false,
  VoidCallback? onToggle,      
  bool showToggle = false,     
}) {
  return Column(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      Padding(
        padding: const EdgeInsets.only(left: 8, bottom: 4),
        child: Text(
          label,
          style: TextStyle(
            fontSize: fontLabel,
            color: Colors.black54,
            letterSpacing: 1.2,
            fontWeight: FontWeight.w600,
          ),
        ),
      ),
      CustomPaint(
        painter: SketchBorderPainter(),
        child: Container(
          height: height,
          padding: const EdgeInsets.symmetric(horizontal: 12),
          child: Row(
  children: [
    Icon(icon, color: Colors.black54, size: fontInput * 1.3),
    const SizedBox(width: 10),
    Expanded(
      child: TextField(
        controller: controller,
        obscureText: obscure,
        style: TextStyle(fontSize: fontInput, color: Colors.black87),
        decoration: const InputDecoration(
          border: InputBorder.none,
          isCollapsed: true,
          contentPadding: EdgeInsets.symmetric(vertical: 14),
        ),
      ),
    ),

   
    if (showToggle)
      GestureDetector(
        onTap: onToggle,
        behavior: HitTestBehavior.opaque,
        child: Padding(
          padding: const EdgeInsets.all(8),
          child: Icon(
            obscure
                ? Icons.visibility_outlined
                : Icons.visibility_off_outlined,
            color: Colors.black54,
            size: fontInput * 1.3,
          ),
        ),
      ),
  ],
),
        ),
      ),
    ],
  );
}

  Widget _buildButton({
    required String text,
    required double fontSize,
    required double height,
    required VoidCallback onTap,
  }) {
    return GestureDetector(
      onTap: onTap,
      child: CustomPaint(
        painter: SketchBorderPainter(),
        child: Container(
          height: height,
          alignment: Alignment.center,
          child: Text(
            text,
            style: TextStyle(
              fontSize: fontSize,
              fontWeight: FontWeight.bold,
              letterSpacing: 2,
              color: Colors.black87,
            ),
          ),
        ),
      ),
    );
  }
}