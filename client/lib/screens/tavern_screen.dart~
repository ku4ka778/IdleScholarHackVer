import 'package:flutter/material.dart';
import '../services/api_client.dart';
import '../services/session.dart';
import '../services/localization.dart';

class TavernScreen extends StatefulWidget {
  const TavernScreen({super.key});

  @override
  State<TavernScreen> createState() => _TavernScreenState();
}

class _TavernScreenState extends State<TavernScreen> {
  List<Map<String, dynamic>> _recipes = [];
  int _activeG = 0, _activeE = 0, _activeL = 0;
  bool _loading = true;

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final charId = Session.characterId;
    if (charId == null) return;

    setState(() => _loading = true);
    try {
      final resp = await apiClient.getFoodRecipes(charId);
      if (resp['success'] == true) {
        setState(() {
          _recipes = (resp['recipes'] as List<dynamic>?)?.cast<Map<String, dynamic>>() ?? [];
          _activeG = resp['active_food_gold_pct'] ?? 0;
          _activeE = resp['active_food_exp_pct'] ?? 0;
          _activeL = resp['active_food_luck_pct'] ?? 0;
          _loading = false;
        });
      }
    } catch (e) {
      debugPrint('Tavern load error: $e');
      setState(() => _loading = false);
    }
  }

  Future<void> _buy(String code) async {
    final charId = Session.characterId;
    if (charId == null) return;

    try {
      final resp = await apiClient.buyFood(charId, code);
      if (resp['success'] == true) {
        ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Еда куплена! Бафф активен до конца следующей экспедиции.')));
        _load();
      } else {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(resp['message'] ?? 'Error')));
      }
    } catch (e) {
      debugPrint('Buy error: $e');
    }
  }

  @override
  Widget build(BuildContext context) {
    if (_loading) return const Scaffold(body: Center(child: CircularProgressIndicator()));

    return Scaffold(
      appBar: AppBar(title: const Text('Трактир')),
      body: Column(
        children: [
          if (_activeG > 0 || _activeE > 0 || _activeL > 0)
            Container(
              width: double.infinity,
              color: Colors.green.withOpacity(0.2),
              padding: const EdgeInsets.all(12),
              child: Column(
                children: [
                  const Text('Активный бафф на следующую экспедицию:', style: TextStyle(fontWeight: FontWeight.bold)),
                  Wrap(
                    spacing: 12,
                    children: [
                      if (_activeG > 0) Text('+$_activeG% Золота', style: const TextStyle(color: Colors.green)),
                      if (_activeE > 0) Text('+$_activeE% Опыта', style: const TextStyle(color: Colors.blue)),
                      if (_activeL > 0) Text('+$_activeL% Удачи', style: const TextStyle(color: Colors.orange)),
                    ],
                  ),
                ],
              ),
            ),
          
          Expanded(
            child: ListView.builder(
              padding: const EdgeInsets.all(16),
              itemCount: _recipes.length,
              itemBuilder: (context, index) {
                final r = _recipes[index];
                return Card(
                  margin: const EdgeInsets.only(bottom: 12),
                  child: ListTile(
                    title: Text(r['name'], style: const TextStyle(fontWeight: FontWeight.bold)),
                    subtitle: Text('${r['description']}\nЦена: ${r['cost_amount']} ${resourceName(r['cost_resource'])}'),
                    isThreeLine: true,
                    trailing: ElevatedButton(
                      onPressed: () => _buy(r['code']),
                      child: const Text('КУПИТЬ'),
                    ),
                  ),
                );
              },
            ),
          ),
        ],
      ),
    );
  }
}
