import 'package:flutter/material.dart';
import '../gen/equipment.pbgrpc.dart';
import '../services/equipment_client.dart';
import '../services/session.dart';

class CharacterScreen extends StatefulWidget {
  const CharacterScreen({super.key});

  @override
  State<CharacterScreen> createState() => _CharacterScreenState();
}

class _CharacterScreenState extends State<CharacterScreen> {
  final _client = EquipmentClient();
  List<EquipmentItem> _items = [];
  int _totalAtk = 0;
  int _totalDef = 0;
  int _totalLuck = 0;
  bool _loading = true;

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final charId = Session.characterId;
    if (charId == null) return;

    setState(() => _loading = true);
    try {
      await _client.connect();
      final resp = await _client.getEquipment(charId);
      if (resp.success) {
        setState(() {
          _items = resp.items;
          _totalAtk = resp.totalAttack;
          _totalDef = resp.totalDefense;
          _totalLuck = resp.totalLuck;
          _loading = false;
        });
      }
    } catch (e) {
      debugPrint('Load error: $e');
      setState(() => _loading = false);
    }
  }

  Future<void> _toggleEquip(EquipmentItem item) async {
    final charId = Session.characterId;
    if (charId == null) return;

    try {
      if (item.equipped) {
        await _client.unequip(charId, item.id);
      } else {
        await _client.equip(charId, item.id);
      }
      await _load();
    } catch (e) {
      debugPrint('Equip error: $e');
    }
  }

  String _statText(EquipmentItem item) {
    final parts = <String>[];
    if (item.attack > 0) parts.add('ATK +${item.attack}');
    if (item.defense > 0) parts.add('DEF +${item.defense}');
    if (item.luck > 0) parts.add('LUCK +${item.luck}');
    return parts.isEmpty ? 'No stats' : parts.join(', ');
  }

  @override
  Widget build(BuildContext context) {
    if (_loading) {
      return const Scaffold(body: Center(child: CircularProgressIndicator()));
    }

    return Scaffold(
      appBar: AppBar(title: const Text('Character')),
      body: Column(
        children: [
          Padding(
            padding: const EdgeInsets.all(16.0),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceAround,
              children: [
                Text('ATK: $_totalAtk', style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
                Text('DEF: $_totalDef', style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
                Text('LUCK: $_totalLuck', style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
              ],
            ),
          ),
          const Divider(),
          Expanded(
            child: ListView.builder(
              itemCount: _items.length,
              itemBuilder: (context, index) {
                final item = _items[index];
                return ListTile(
                  title: Text('${item.name} (${item.slot})'),
                  subtitle: Text(_statText(item)),
                  trailing: item.equipped 
                      ? OutlinedButton(
                          onPressed: () => _toggleEquip(item),
                          child: const Text('Unequip'),
                        )
                      : ElevatedButton(
                          onPressed: () => _toggleEquip(item),
                          child: const Text('Equip'),
                        ),
                  tileColor: item.equipped ? Colors.green.withOpacity(0.1) : null,
                );
              },
            ),
          ),
        ],
      ),
    );
  }
}
