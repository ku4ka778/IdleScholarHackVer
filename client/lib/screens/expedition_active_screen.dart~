import 'dart:io';
import 'dart:async';
import 'package:flutter/material.dart';
import '../services/expedition_client.dart';
import '../services/session.dart';

class ExpeditionActiveScreen extends StatefulWidget {
  final int locationIndex;
  final int durationMinutes;
  final String domains;
  final String apps;

  const ExpeditionActiveScreen({
    super.key,
    required this.locationIndex,
    required this.durationMinutes,
    required this.domains,
    required this.apps,
  });

  @override
  State<ExpeditionActiveScreen> createState() => _ExpeditionActiveScreenState();
}

class _ExpeditionActiveScreenState extends State<ExpeditionActiveScreen> {
  final _expeditionClient = ExpeditionClient();
  Process? _agentProcess;
  Timer? _heartbeatTimer;
  Timer? _uiTimer;

  int _remainingSeconds = 0;
  
  int _totalGoldEarned = 0;
  int _totalExpEarned = 0;
  List<String> _allLoot = [];
  
  // Logs
  List<String> _logs = [];

  @override
  void initState() {
    super.initState();
    _remainingSeconds = widget.durationMinutes * 60;
    _startExpedition();
  }

  @override
  void dispose() {
    _heartbeatTimer?.cancel();
    _uiTimer?.cancel();
    _agentProcess?.stdin.writeln('stop');
    _agentProcess?.kill();
    super.dispose();
  }

  Future<void> _startExpedition() async {
    final charId = Session.characterId;
    if (charId == null) {
      _addLog('Error: No character selected.');
      return;
    }

    try {
      await _expeditionClient.connect();
      
      final domainsList = widget.domains.split(',').map((e) => e.trim()).where((e) => e.isNotEmpty).toList();
      final appsList = widget.apps.split(',').map((e) => e.trim()).where((e) => e.isNotEmpty).toList();

      final resp = await _expeditionClient.startExpedition(
        characterId: charId,
        durationMinutes: widget.durationMinutes,
        activityType: 0,
        activityLevel: widget.locationIndex,
        allowedDomains: domainsList,
        allowedApps: appsList,
      );

      if (!resp.success) {
        _addLog('Server error: ${resp.message}');
        return;
      }

      final agentPath = File('../agent/publish/Agent.exe').absolute.path;
      _agentProcess = await Process.start(
        agentPath,
        [
          '--domains', widget.domains,
          '--apps', widget.apps,
          '--duration', widget.durationMinutes.toString(),
        ],
        workingDirectory: Directory.current.path,
        runInShell: true,
      );

      _agentProcess!.stdout.transform(SystemEncoding().decoder).listen((data) {
        debugPrint('AGENT: $data');
      });
      
      _addLog('Expedition started. Focus mode active.');

      // Start UI Timer
      _uiTimer = Timer.periodic(const Duration(seconds: 1), (timer) {
        if (!mounted) return;
        setState(() {
          if (_remainingSeconds > 0) {
            _remainingSeconds--;
          } else {
            timer.cancel();
          }
        });
      });

      // Start Heartbeat
      _heartbeatTimer = Timer.periodic(const Duration(seconds: 30), (timer) async {
        try {
          final hbResp = await _expeditionClient.sendHeartbeat(charId);
          
          if (hbResp.goldGained > 0 || hbResp.itemsGained.isNotEmpty) {
            setState(() {
              _totalGoldEarned += hbResp.goldGained.toInt();
              _totalExpEarned += hbResp.expGained.toInt();
              _allLoot.addAll(hbResp.itemsGained);
              
              _addLog('Cycle complete: +${hbResp.goldGained} Gold, +${hbResp.expGained} EXP.');
              if (hbResp.itemsGained.isNotEmpty) {
                _addLog('Loot: ${hbResp.itemsGained.join(", ")}');
              }
            });
          }

          if (!hbResp.isActive) {
            timer.cancel();
            _uiTimer?.cancel();
            _finishExpedition();
          }
        } catch (e) {
          _addLog('Heartbeat error: $e');
        }
      });

    } catch (e) {
      _addLog('Start error: $e');
    }
  }

  Future<void> _finishExpedition() async {
    final charId = Session.characterId;
    if (charId == null) return;

    _heartbeatTimer?.cancel();
    _uiTimer?.cancel();
    
    _agentProcess?.stdin.writeln('stop');
    await Future.delayed(const Duration(seconds: 2));
    _agentProcess?.kill();
    _agentProcess = null;

    try {
      final finishResp = await _expeditionClient.finishExpedition(charId);
      
      if (finishResp.success) {
        setState(() {
          _totalGoldEarned += finishResp.goldGained.toInt();
          _totalExpEarned += finishResp.expGained.toInt();
          _allLoot.addAll(finishResp.itemsGained);
          _addLog('Expedition finished successfully.');
        });
        
        if (mounted) {
          showDialog(
            context: context,
            barrierDismissible: false,
            builder: (_) => AlertDialog(
              title: const Text('Expedition Complete'),
              content: Text(
                'Total earned:\n'
                'Gold: $_totalGoldEarned\n'
                'EXP: $_totalExpEarned\n'
                'Items: ${_allLoot.join(", ")}'
              ),
              actions: [
                TextButton(
                  onPressed: () {
                    Navigator.pop(context); // Close dialog
                    Navigator.pop(context); // Go back to setup
                  }, 
                  child: const Text('Return')
                )
              ],
            )
          );
        }
      }
    } catch (e) {
      _addLog('Finish error: $e');
    }
  }

  Future<void> _manualStop() async {
    final charId = Session.characterId;
    if (charId == null) return;
    
    _agentProcess?.stdin.writeln('stop');
    await Future.delayed(const Duration(seconds: 1));
    _agentProcess?.kill();
    _agentProcess = null;
    
    _heartbeatTimer?.cancel();
    _uiTimer?.cancel();
    
    await _expeditionClient.stopExpedition(charId);
    _addLog('Expedition stopped manually.');
    
    if (mounted) {
       Navigator.pop(context);
    }
  }

  void _addLog(String message) {
    if (!mounted) return;
    setState(() {
      _logs.insert(0, '[${_formatTime(_remainingSeconds)}] $message'); // Newest at top
    });
  }

  String _formatTime(int totalSeconds) {
    final minutes = (totalSeconds ~/ 60).toString().padLeft(2, '0');
    final seconds = (totalSeconds % 60).toString().padLeft(2, '0');
    return '$minutes:$seconds';
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Expedition in Progress'),
        automaticallyImplyLeading: false,
      ),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            // Timer
            Text(
              _formatTime(_remainingSeconds),
              textAlign: TextAlign.center,
              style: const TextStyle(fontSize: 64, fontWeight: FontWeight.bold),
            ),
            
            const SizedBox(height: 16),
            
            // Summary
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceEvenly,
              children: [
                Text('Total Gold: $_totalGoldEarned', style: const TextStyle(fontSize: 18)),
                Text('Total EXP: $_totalExpEarned', style: const TextStyle(fontSize: 18)),
              ],
            ),
            
            const SizedBox(height: 16),
            const Divider(),
            const Text('Logs:', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
            const SizedBox(height: 8),
            
            // Logs
            Expanded(
              child: Container(
                decoration: BoxDecoration(
                  color: Colors.black12,
                  borderRadius: BorderRadius.circular(8),
                ),
                padding: const EdgeInsets.all(8.0),
                child: ListView.builder(
                  itemCount: _logs.length,
                  itemBuilder: (context, index) {
                    return Padding(
                      padding: const EdgeInsets.symmetric(vertical: 4.0),
                      child: Text(
                        _logs[index],
                        style: const TextStyle(fontFamily: 'monospace', fontSize: 13),
                      ),
                    );
                  },
                ),
              ),
            ),
            
            const SizedBox(height: 16),
            
            // Stop Button
            ElevatedButton(
              onPressed: _manualStop,
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.red,
                padding: const EdgeInsets.symmetric(vertical: 16),
              ),
              child: const Text('STOP EXPEDITION', style: TextStyle(color: Colors.white, fontSize: 18)),
            ),
          ],
        ),
      ),
    );
  }
}
