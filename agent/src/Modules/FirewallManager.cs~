using System;
using System.Diagnostics;

namespace Agent.Modules
{
    public static class FirewallManager
    {
        private static readonly string[] RulesToDelete = {
            "FocusMode Allow Agent All", "FocusMode Block External DNS",
            "FocusMode Block External DNS TCP", "FocusMode Block DoH Cloudflare",
            "FocusMode Block DoH Google", "FocusMode Block DoH Quad9",
            "FocusMode Block DoH Extended", "FocusMode Block DoT",
            "FocusMode Allow Upstream DNS", "FocusMode Allow Upstream DNS TCP",
            "FocusMode Allow Upstream DNS In", "FocusMode Allow Loopback",
            "FocusMode Allow Loopback In"
        };

        private const string DohServers = "1.1.1.1,1.0.0.1,104.16.0.0/13,172.64.0.0/13,8.8.8.8,8.8.4.4,9.9.9.9,149.112.112.112,94.140.14.14,94.140.15.15,76.76.2.0,76.76.10.0,185.228.168.9,185.228.169.9,208.67.222.222,208.67.220.220,156.154.70.1,156.154.71.1,64.6.64.6,64.6.65.6,77.88.8.8,77.88.8.1";

        public static void ApplyRules(string upstreamDnsIp)
        {
            Console.WriteLine("[FW] Applying firewall rules...");
            RemoveRules();

            string exePath = Environment.ProcessPath ?? Process.GetCurrentProcess().MainModule?.FileName;
            if (string.IsNullOrEmpty(exePath)) return;

            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Allow Loopback\" dir=out action=allow remoteip=127.0.0.0/8 profile=any");
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Allow Loopback In\" dir=in action=allow remoteip=127.0.0.0/8 profile=any");
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Allow Agent All\" dir=out action=allow program=\"{exePath}\" profile=any");
            
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Allow Upstream DNS\" dir=out action=allow program=\"{exePath}\" protocol=UDP remoteport=53 profile=any");
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Allow Upstream DNS TCP\" dir=out action=allow program=\"{exePath}\" protocol=TCP remoteport=53 profile=any");
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Allow Upstream DNS In\" dir=in action=allow program=\"{exePath}\" protocol=UDP remoteport=53 profile=any");

            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Block External DNS\" dir=out action=block protocol=UDP remoteport=53 remoteip=1.0.0.0-126.255.255.255,128.0.0.0-192.168.0.0,192.168.0.2-255.255.255.255 profile=any");
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Block External DNS TCP\" dir=out action=block protocol=TCP remoteport=53 remoteip=1.0.0.0-126.255.255.255,128.0.0.0-192.168.0.0,192.168.0.2-255.255.255.255 profile=any");

            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Block DoH Cloudflare\" dir=out action=block protocol=TCP remoteport=443 remoteip=1.1.1.1,1.0.0.1,104.16.0.0/13,172.64.0.0/13 profile=any");
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Block DoH Google\" dir=out action=block protocol=TCP remoteport=443 remoteip=8.8.8.8,8.8.4.4 profile=any");
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Block DoH Quad9\" dir=out action=block protocol=TCP remoteport=443 remoteip=9.9.9.9,149.112.112.112 profile=any");
            
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Block DoH Extended\" dir=out action=block protocol=TCP remoteport=443 remoteip={DohServers} profile=any");
            RunNetsh($"advfirewall firewall add rule name=\"FocusMode Block DoT\" dir=out action=block protocol=TCP remoteport=853 profile=any");

            Console.WriteLine("[FW] Rules applied.");
        }

        public static void RemoveRules()
        {
            Console.WriteLine("[FW] Removing firewall rules...");
            foreach (var rule in RulesToDelete)
            {
                RunNetsh($"advfirewall firewall delete rule name=\"{rule}\"");
            }
            Console.WriteLine("[FW] Rules removed.");
        }

        private static void RunNetsh(string args)
        {
            try
            {
                var psi = new ProcessStartInfo("netsh", args)
                {
                    CreateNoWindow = true,
                    UseShellExecute = false,
                    RedirectStandardOutput = true,
                    RedirectStandardError = true
                };
                using var process = Process.Start(psi);
                process?.WaitForExit();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[FW] Error running netsh: {ex.Message}");
            }
        }
    }
}
